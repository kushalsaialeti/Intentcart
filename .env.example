# IntentCart LLM Configuration
# Copy this file to .env and fill in at least one API key.

# 1. Google Gemini API (Free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 2. Groq Cloud API (Free ultra-fast tier: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# 3. Router Strategy:
# - 'race' (Recommended): Queries Gemini and Groq in parallel; whichever model answers first wins!
# - 'fallback': Queries primary model, falls back to alternative on rate-limit/error
# - 'gemini': Force Gemini only
# - 'groq': Force Groq only
LLM_PROVIDER_MODE=race

# 4. Hyperparameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=15.0
